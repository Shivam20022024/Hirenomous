# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=Hireonomous
APP_VERSION=1.0.0
DEBUG=false

# --- MongoDB (required) ---
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=voiceai

# --- Auth ---
# 64-hex random string. Also used to hash interview tokens if INTERVIEW_TOKEN_SECRET is unset.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- OpenAI (required) — resume parsing, interview STT/TTS, evaluation ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1

# --- OpenRouter (required) — scoring / classification / email drafting ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_API_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT=60

# --- Hiring logic ---
SHORTLIST_THRESHOLD=70

# --- Bolna (AI phone screening) ---
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_CALLBACK_API_TOKEN=

# --- Google Drive resume import (optional) ---
GOOGLE_DRIVE_API_KEY=

# --- AI Video Interview ---
# Public HTTPS origin of the candidate-facing frontend (where /interview/<token> is served).
INTERVIEW_PUBLIC_BASE_URL=https://app.example.com
INTERVIEW_TOKEN_TTL_HOURS=72
INTERVIEW_QUESTION_COUNT=8
INTERVIEW_MAX_FOLLOWUPS=3
INTERVIEW_TTS_VOICE=alloy
# INTERVIEW_TOKEN_SECRET=            # optional; falls back to SECRET_KEY
INTERVIEW_MEDIA_DIR=media/interviews
INTERVIEW_MEDIA_MAX_MB=200

# --- Email (SMTP) — works from EC2 on port 587; blocked on Render/Vercel ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Billing (Razorpay) ---
# Free from the Razorpay dashboard (test mode first). The 7-day trial gate
# enforces itself regardless of these — leave them unset and expired companies
# still get blocked, but the paywall shows "contact your account manager"
# instead of a live checkout (use the super admin "Grant 30d" button to keep
# a company running without Razorpay). Live keys start with rzp_live_, test
# keys with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > Secret — only needed if you set up a webhook (recommended
# as a backstop for verify calls that never reach the backend, e.g. tab closed mid-checkout).
RAZORPAY_WEBHOOK_SECRET=
# Free trial length for every newly approved company.
TRIAL_DAYS=7
# Pricing — change to whatever you're actually charging.
BILLING_PLAN_AMOUNT_INR=2999
BILLING_PLAN_DAYS=30
